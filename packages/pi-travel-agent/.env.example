# 复制成 .env 再改。.env 不进 git。
TRAVEL_MODEL_ID=qwen3.7-plus
TRAVEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 1M 是总信封，qwen3.6/3.7-plus 的模型卡写的是「输入最多 991.8K + 输出最多 65,536」。
# 这两个数 Step 7 之前没有任何人读，从 Step 7 起压缩阈值靠它算，填错了不会当场报错。
TRAVEL_CONTEXT_WINDOW=1000000
TRAVEL_MAX_TOKENS=65536

# key 怎么取,而不是 key 本身:
#   !<cmd>      执行命令取 stdout(推荐,key 留在 keychain 里)
#   env:<NAME>  读环境变量
TRAVEL_API_KEY_SOURCE=!security find-generic-password -ws pi-dashscope

# 高德 Web 服务 key（console.amap.com 申请，类型必须选「Web服务」，不是 JS API）。
# 直接写明文：.env 已被 gitignore，不会进版本库。
AMAP_KEY=

# DeepSeek 官方 API（--model deepseek）。不用就整段留空，其它 provider 不受影响。
#
# 型号：deepseek-v4-flash 便宜，deepseek-v4-pro 贵三倍。价格写在 src/core/model.ts 的
# DEEPSEEK_COST 里（$/百万 token），填了这张表里没有的 id 不会报错，只是账上记 0。
# 那里填的是 off-peak 价：DeepSeek 自 2026-08-16 起按时段计价，峰时翻倍，一张静态表装不下。
#
# 下面这两个数是核对过的（pi 的 deepseek.json、官方 api-docs、OpenRouter 三处一致）：
# 1M 是**总信封**，不是最大输入。Step 7 的压缩阈值要读它，填错了不会当场报错，
# 而是等真撞上限时由 provider 甩一个 400 —— 换型号时记得跟着改。
#
# 值得单说：DeepSeek 会返回 prompt_cache_hit_tokens，qwen3.6-plus 不返回 ——
# 所以摘要行里的 cache 那一项只有在这条路上才有数。见 docs/prompt.md 第七节。
#
# BASE_URL 不带 /v1：pi 自己的 deepseek.json 就是这么填的，SDK 会补 /chat/completions。
DEEPSEEK_MODEL_ID=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CONTEXT_WINDOW=1000000
DEEPSEEK_MAX_TOKENS=384000
# key 取法同上：!<cmd> 或 env:<NAME>。platform.deepseek.com 申请。
DEEPSEEK_API_KEY_SOURCE=env:DEEPSEEK_API_KEY
DEEPSEEK_API_KEY=

# 局域网 Ollama（--model local）。不用就整段留空，qwen 不受影响。
# LOCAL_CONTEXT_WINDOW 填服务端实际的 num_ctx，不是 /api/tags 报的 context_length。
LOCAL_MODEL_ID=qwen3.5-9b-q4km:latest
LOCAL_BASE_URL=http://192.168.100.4:11434/v1
LOCAL_CONTEXT_WINDOW=8192
LOCAL_MAX_TOKENS=2048
LOCAL_API_KEY=ollama
